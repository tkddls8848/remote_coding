# .env 로 복사해서 비밀만 채운다. .env 는 커밋되지 않는다(.gitignore).
#
# 버전·포트·메모리 한도·sudo 정책 같은 나머지 설정은 코드의 기본값을 쓴다
# (scripts/util/lib.sh, gpu-art/scripts/lib.sh, gpu-art/runpod/gpu.py).
# 기본값을 바꿀 때만 README.md 의 "설정" 절에서 변수를 골라 이 파일에 한 줄 추가한다.
# AWS 자원 설정은 terraform/terraform.tfvars 에 있다.

# Orca 서비스 계정(ubuntu)의 로컬 비밀번호. SSH 는 공개키로만 붙는다.
# 빈 값이면 기존 비밀번호를 바꾸지 않는다.
ORCA_SERVICE_PASSWORD=ubuntu

# 장애·보안 알림 웹훅 (Slack/Discord 호환 JSON {"text": ...}).
# 비우면 서버의 /var/log/orca-alert.log 에만 남는다.
ALERT_WEBHOOK=

# RunPod 그림 서버 (gpu-art/runpod/gpu.py). RunPod 웹 → Settings → API Keys.
RUNPOD_API_KEY=

# 그림 서버의 Tailscale auth key. 비우면 처음 켤 때 인증 URL 을 출력하고 기다린다.
GPU_TS_AUTHKEY=
