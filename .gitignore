# 로컬 시스템 상태 백업 / 실행 로그 — 공개 리포에 올리지 않는다
backup/
*.wfw
*transcript*.txt

# 자격증명 / 환경값
.env
.env.*
!/.env.example
*.pem
*.key
*-pairing*.txt

# OS
Thumbs.db
.DS_Store

# ─────────────────────────────────────────────────────────────
# Orca 상시 개발 서버.
#
# 이 저장소는 remote-lightsail/ 하위였다가 루트로 올라왔다. 접두사와 실제 경로가
# 어긋나면 아무것도 막히지 않으므로 폴더 구조가 바뀔 때마다 아래도 같이 고친다.
# ─────────────────────────────────────────────────────────────

# Terraform — state 에 리소스 상세(IP 등)가 그대로 담긴다.
# .terraform.lock.hcl 은 provider 버전 고정용이라 예외적으로 커밋한다.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
!terraform/terraform.tfvars.example
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/*.tfvars
terraform/**/*.tfplan
terraform/crash.log
terraform/crash.*.log
# remote backend 설정 — 버킷 이름은 배포마다 다르고 공개 리포에 둘 이유가 없다.
# 템플릿은 backend.tf.example 로 커밋한다 (docs/stability-plan.md 3.1).
terraform/backend.tf

# 그림 GPU 서버 (gpu-art/) — 최상위 terraform/ 과 같은 이유로 state · tfvars 를 넣지 않는다.
gpu-art/terraform/.terraform/
gpu-art/terraform/*.tfstate
gpu-art/terraform/*.tfstate.*
gpu-art/terraform/*.tfvars
!gpu-art/terraform/terraform.tfvars.example
gpu-art/terraform/*.tfplan
# RunPod 그림 서버의 로컬 상태 (gpu-art/runpod/gpu.py — SSH 터널 pid · 팟별 호스트 키)
.gpu-art/
!terraform/backend.tf.example

# 에이전트 로컬 설정
**/.claude

# 파이썬 바이트코드
__pycache__/
