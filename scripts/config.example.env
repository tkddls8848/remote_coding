# scripts/config.env 로 복사해서 채운다. config.env 는 커밋되지 않는다(.gitignore).
# 여기에 실제 저장소 목록 등을 적더라도 리포지토리에는 올라가지 않는다.
#
# AWS 자원(인스턴스/고정 IP/방화벽) 설정은 여기가 아니라 terraform/terraform.tfvars 에 있다.

# --- 호스트 ---
# 입주 앱의 cron.d 는 타임존을 선언할 수 없어 호스트 설정을 그대로 따른다. Lightsail
# 자동 스냅샷 시각도 UTC 정시이므로 호스트를 UTC 로 고정해 두 시각을 같은 기준으로 읽는다.
# 이 값을 바꾸면 입주 앱 저장소의 백업 cron 시각도 함께 옮겨야 한다.
HOST_TIMEZONE=UTC

# --- Orca 서버 ---
# 배포 재현성을 위해 명시적으로 고정한다. 업그레이드 전 릴리스 노트를 확인한다.
ORCA_VERSION=v1.4.188
ORCA_PORT=6768
ORCA_SERVICE_USER=orca

# orca-serve 유닛의 메모리 상한. 커널 OOM killer 가 임의의 프로세스를 죽이게 두는 대신
# 한도를 넘은 이 서비스만 예측 가능하게 멈추게 한다. 4GB 호스트 기준값이다.
ORCA_MEMORY_HIGH=2G
ORCA_MEMORY_MAX=2800M

# 서비스 계정의 로컬 비밀번호. `ubuntu` 에서 `su - orca` 로 넘어갈 때만 쓴다. SSH 는
# 06-vscode-remote.sh 가 이 계정의 비밀번호 인증을 꺼 두므로 원격 로그인에는 쓰이지 않는다.
# 비워 두면 비밀번호를 설정하지 않고 계정을 잠긴 상태로 둔다. 쓰려면 config.env 에만
# 적는다(커밋되지 않는다). 이 호스트는 입주 앱과 공유하므로 짧은 값은 다른 계정에
# `su` 경로를 열어 주는 선택이라는 점을 알고 정한다.
#
#   openssl rand -base64 32
#
ORCA_SERVICE_PASSWORD=
ORCA_SERVICE_PASSWORD_MIN_LEN=16

# 이 계정의 sudo 권한: nopasswd | whitelist | password | off
# 기본 nopasswd 는 이 계정으로 붙은 사람과 에이전트가 비밀번호 없이 호스트를 관리하게
# 한다. headless 에이전트는 비밀번호를 입력할 방법이 없고, 계정 비밀번호를 비워 두면
# password 모드의 sudo 는 통과할 수 없다.
# 이 호스트는 입주 앱과 공유하므로, sudo 는 /srv/<앱>/.env 를 포함한 호스트 전체에
# 대한 접근을 여는 것과 같다. 열지 않으려면 off 로 둔다.
#
# whitelist 는 그 중간이다 — 아래 ORCA_SUDO_WHITELIST 에 열거한 명령만 NOPASSWD 로
# 통과시킨다. 먼저 nopasswd + ORCA_SUDO_LOG=on 으로 며칠 돌려 `sudoreplay -l` 로 실제
# 쓰이는 명령을 관찰한 뒤 목록을 좁혀 whitelist 로 넘어가는 것이 안전하다.
# docs/stability-plan.md 6.0~6.1 참조.
ORCA_SERVICE_SUDO=nopasswd

# whitelist 모드에서 허용할 명령 (sudoers Cmnd 문법, 줄 단위). 비우면 lib.sh 의 기본
# 목록(자기 유닛 제어 + apt-get)을 쓴다. 여러 줄은 아래처럼 적는다:
#
#   ORCA_SUDO_WHITELIST='/usr/bin/systemctl restart orca-serve.service
#   /usr/bin/apt-get install *'
#
# ORCA_SUDO_WHITELIST=

# sudo I/O 로깅. 누가 무엇을 root 로 실행했는지 남기는 최소선이며 `sudoreplay` 로
# 재생한다. 화이트리스트를 아직 못 하더라도 이것만은 켜 둔다.
ORCA_SUDO_LOG=on
ORCA_SUDO_LOG_DIR=/var/log/sudo-io

# --- Orca 바이너리 무결성 (docs/stability-plan.md 4.3) ---
# 값을 적어 두면 04-orca-server.sh 가 다운로드를 이 값과 대조하고 다르면 설치하지 않는다.
# 비워 두면 릴리스의 체크섬 파일을 먼저 찾고, 그것도 없으면 실제 값을 출력하므로 그대로
# 여기에 옮겨 적으면 다음 설치부터 검증된다.
ORCA_SHA256=
# 1 이면 기대 체크섬을 구하지 못했을 때 아예 설치를 중단한다.
ORCA_REQUIRE_CHECKSUM=0
# 불완전 다운로드 거부 하한(바이트). 기본 50MB.
ORCA_MIN_BYTES=52428800

# 비우면 install/04-orca-server.sh가 Tailscale Serve HTTPS와 MagicDNS 주소를 구성한다.
# 외부 TLS 프록시를 쓸 때만 완전한 HTTPS/WSS 주소로 덮어쓴다.
# 평문 Tailscale IP(100.x.x.x)나 http:// 주소는 Web Crypto가 차단되므로 사용하지 않는다.
ORCA_PAIRING_ADDRESS=

# 안정적인 MagicDNS 호스트명. 비우면 sync-host.sh가 Terraform의 instance_name을 사용한다.
TAILSCALE_HOSTNAME=

# --- 에이전트 CLI 버전 ---
# latest 는 매 실행 최신을 받는다(재현성 없음). 배포를 고정하려면 정확한 버전을 적는다.
#   npm view @openai/codex version
CLAUDE_CODE_VERSION=latest
CODEX_VERSION=latest

# --- VS Code Remote-SSH (orca 계정) ---
# orca 계정에만 등록할 전용 공개키다. 파일 경로 또는 `ssh-ed25519 AAAA... 주석` 원문.
# 관리 PC에서 만든다:
#   ssh-keygen -t ed25519 -f ~/.ssh/orca_vscode -C "vscode->orca"
#
# 비워 두면 06-vscode-remote.sh 는 중단한다. ubuntu 의 키를 그대로 복사하면 키 하나가
# 두 계정을 동시에 열고, orca 는 sudo 를 가지므로 키 탈취가 곧 호스트 root 다 (6.3).
ORCA_SSH_PUBLIC_KEY=

# 1 이면 예전처럼 ubuntu 의 authorized_keys 를 orca 로 복사한다. 위험을 알고 켤 때만 쓴다.
ORCA_SSH_REUSE_ADMIN_KEY=0

# --- install/05-repos.sh: Orca 서비스 계정으로 클론할 레포 ---
# 에이전트는 여기 등록된 저장소의 내용을 읽고 그에 따라 명령을 실행한다. 즉 이 목록이
# 이 호스트의 신뢰경계다. 실제 작업 대상만 명시적으로 적는 것을 권장한다:
#
#   REPOS="gong-go homepage"
#
# all 이면 GITHUB_OWNER 의 저장소를 gh 로 열거한다. 이 경우에도 기본적으로 포크와
# 보관된 저장소는 뺀다 (REPOS_INCLUDE_FORKS / REPOS_INCLUDE_ARCHIVED).
# 토큰에 repo 스코프가 필요하다.
REPOS=all
REPOS_EXCLUDE=""
REPOS_INCLUDE_FORKS=0
REPOS_INCLUDE_ARCHIVED=0
GITHUB_OWNER=tkddls8848

# 토큰 반경: `repo` 전체 스코프 classic PAT 는 이 호스트가 뚫리는 순간 모든 프라이빗
# 저장소로 간다. REPOS 를 명시 목록으로 좁혔다면 토큰도 같이 좁힌다 — Fine-grained PAT 를
# 만들고 Repository access 를 그 저장소들로만 한정한 뒤 `gh auth login` 을 다시 한다.
# (Contents: Read and write, Metadata: Read 면 클론·푸시에 충분하다.)
# verify-host.sh 와 주간 타이머가 `gh api user` 로 유효성을 확인한다.

# --- 알림 (install/07-monitoring.sh) ---
# 서비스 장애, 디스크/스왑 임계, SSH 로그인, 토큰 만료를 보낼 웹훅.
# Slack/Discord 호환 JSON({"text": ...})을 POST 한다. 비워 두면 /var/log/orca-alert.log
# 에만 남긴다. 값은 커밋하지 않는다 — 서버에서는 /etc/orca/alert.env(0600 root)에 들어간다.
ALERT_WEBHOOK=

DISK_WARN_PERCENT=80
SWAP_WARN_PERCENT=70
JOURNAL_MAX_USE=500M

# --- 백업 (util/backup-orca.sh) ---
# s3://버킷/접두사. 비우면 로컬 아카이브만 만든다.
BACKUP_S3_URI=
# SSE-KMS 고객 관리 키 ID/ARN. 자격증명을 담는다면 사실상 필수다.
BACKUP_KMS_KEY_ID=
# 1 이면 ~/.codex 와 gh 토큰까지 담는다. 복구는 쉬워지지만 자격증명 사본이 하나 더
# 생기고 그 버킷이 새로운 침해 대상이 된다. 켜기 전에 docs/stability-plan.md 7.1 을 읽는다.
BACKUP_INCLUDE_CREDENTIALS=0
BACKUP_LOCAL_DIR=/var/backups/orca
