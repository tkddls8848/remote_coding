# scripts/config.env 로 복사해서 채운다. config.env 는 커밋되지 않는다(.gitignore).
# 여기에 실제 도메인·IP를 적더라도 리포지토리에는 올라가지 않는다.

# --- AWS / Lightsail (로컬에서 실행하는 스크립트가 사용) ---
REGION=ap-northeast-2
INSTANCE_NAME=orca-host
BUNDLE_ID=medium_3_0          # 4GB. 8GB 로 올릴 때는 large_3_0
BLUEPRINT_ID=ubuntu_24_04
KEY_PAIR_NAME=orca-host-key
SSH_PUBLIC_KEY=~/.ssh/id_ed25519.pub

# --- 접근 경로 ---
# 도메인이 없으면 비워둔다. 02 이후 스크립트가 <STATIC_IP>.sslip.io 를 자동으로 쓴다.
DOMAIN=

# 구축 단계에서 SSH 를 허용할 공인 IP. 비우면 checkip.amazonaws.com 으로 자동 감지.
MY_IP=

# --- Phase 9: 등록할 레포 ---
REPOS="gong-go homepage naraapi pathfinder devlog"
GITHUB_OWNER=tkddls8848
