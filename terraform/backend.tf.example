# S3 remote backend. 쓰려면 이 파일을 backend.tf 로 복사해 값을 채운 뒤
#
#   terraform -chdir=terraform init -migrate-state
#
# 를 한 번 돌린다. 이후 로컬 terraform.tfstate* 는 지운다 (민감 정보가 들어 있다).
#
# 왜 필요한가 (docs/stability-plan.md 3.1):
#   - terraform.tfstate 에는 SSH 키·IP·리소스 ID 가 들어 있다. 관리 PC 를 잃으면
#     인프라 상태를 복구할 수 없다.
#   - 두 곳에서 동시에 apply 하면 state 가 충돌하고 리소스가 중복 생성된다.
#
# 잠금은 S3 네이티브 use_lockfile 로 한다. DynamoDB 테이블은 필요 없다 —
# 단 실행 환경의 terraform 이 1.10 이상이어야 한다 (terraform version 으로 확인).
# 1.10 미만을 써야 하면 use_lockfile 대신 dynamodb_table = "LockTable" 을 둔다.
#
# 버킷은 먼저 만들어 두고 버저닝과 기본 암호화를 켠다:
#
#   aws s3api create-bucket --bucket <버킷> --region ap-northeast-1 \
#     --create-bucket-configuration LocationConstraint=ap-northeast-1
#   aws s3api put-bucket-versioning --bucket <버킷> \
#     --versioning-configuration Status=Enabled
#   aws s3api put-bucket-encryption --bucket <버킷> \
#     --server-side-encryption-configuration \
#     '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"aws:kms"}}]}'
#   aws s3api put-public-access-block --bucket <버킷> \
#     --public-access-block-configuration \
#     BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true

terraform {
  backend "s3" {
    bucket       = "CHANGE-ME-orca-tfstate"
    key          = "remote_coding/terraform.tfstate"
    region       = "ap-northeast-1"
    encrypt      = true
    use_lockfile = true
  }
}
