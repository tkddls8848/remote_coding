# terraform.tfvars 로 복사해서 쓴다. terraform.tfvars 는 .gitignore 에 있다.
#
#   cp terraform.tfvars.example terraform.tfvars

# 도쿄 리전. 이 값으로 apply 하면 도쿄에 인스턴스가 새로 만들어진다.
# 다른 리전 배포가 로컬 state 에 이미 있으면 workspace 로 분리한다(README "도쿄 신규 배포" 참고).
region = "ap-northeast-1"

# 비우면 <region>a 를 쓴다. 다른 AZ 가 필요할 때만 적는다.
# availability_zone = "ap-northeast-1a"

# Orca + 단일 코딩 에이전트 기본값: 4GB RAM, 2 vCPU.
# 병렬 에이전트/브라우저 탭을 자주 쓰면 large_3_0(8GB)을 권장한다.
bundle_id = "medium_3_0"

# 이 배포가 생성할 Lightsail 리소스 이름.
instance_name  = "orca-host-tokyo"
key_pair_name  = "orca-host-tokyo-key"
static_ip_name = "orca-host-tokyo-ip"

# build/final 모두 22(내 IP만)를 유지한다. Orca 6768은 절대 공인망에 열지 않는다.
#   terraform apply -var phase=build
#   terraform apply                    # 기본값 final
phase = "final"

# 입주 앱이 공개 웹을 서비스하고 DNS·리버스 프록시가 준비됐을 때만 true로 바꾼다.
# 앱의 내부 포트는 공인 방화벽에 직접 열지 않는다.
enable_public_web = false

# 매일 19:00 UTC(04:00 KST/JST)에 영속 앱 데이터가 포함된 자동 스냅샷을 만든다.
# 입주 앱은 자기 데이터 백업을 이 시각 앞에 끝낸다(stock_chatbot 은 18:00 UTC).
# 시각을 옮기면 입주 앱 저장소의 백업 시각도 함께 옮긴다.
enable_auto_snapshot = true
auto_snapshot_time   = "19:00"

# SSH(22) 허용 대상. 비워두면 checkip.amazonaws.com 으로 자동 감지해 /32 하나를 연다.
# my_ip = "203.0.113.10"

# 고정된 접속 위치가 둘 이상이면 목록으로 적는다. 값이 있으면 my_ip 와 자동 감지보다
# 우선하고, 자동 감지 호출 자체가 사라진다.
# 단일 /32 만 두면 ISP DHCP·VPN 전환·출장으로 IP 가 바뀌는 순간 잠긴다
# (docs/stability-plan.md 3.2). 긴급 경로로는 Tailscale SSH 를 확보해 둔다.
# admin_cidrs = ["203.0.113.10/32", "198.51.100.0/29"]
