# terraform.tfvars 로 복사해서 쓴다. terraform.tfvars 는 .gitignore 에 있다.
#
#   cp terraform.tfvars.example terraform.tfvars

region = "ap-northeast-2"

# 구축 중에는 build, 평상시에는 final.
#   terraform apply -var phase=build   # 22(내 IP만)+80+443
#   terraform apply                    # 443만 (기본값 final)
phase = "final"

# 비워두면 checkip.amazonaws.com 으로 자동 감지한다.
# my_ip = "203.0.113.10"
