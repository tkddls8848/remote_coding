# terraform.tfvars 로 복사해서 쓴다. terraform.tfvars 는 .gitignore 에 있다.
#
#   cp terraform.tfvars.example terraform.tfvars

# 도쿄. GPU 종류마다 파는 리전이 다르다 — 없으면 plan 이 이유를 말하고 멈춘다.
region = "ap-northeast-1"

# L4 24GB · 8 vCPU · 32GB RAM. 최소는 g4dn.2xlarge, 더 빠른 것은 g5.2xlarge.
# 새 AWS 계정은 G 인스턴스 vCPU 한도가 0 이라 먼저 한도를 올려야 한다(README '처음 한 번').
instance_type = "g6.2xlarge"

instance_name = "art-gpu-tokyo"
key_pair_name = "art-gpu-tokyo-key"

# OS·드라이버 + ComfyUI + 모델(약 17GB) + 결과물.
root_volume_gb = 100

# 오래 이어 돌리면 false(온디맨드). 스팟은 싸지만 회수되면 그리던 한 장이 실패한다.
use_spot = false
# spot_max_price = "0.60"

# SSH(22) 허용 대상. 비워 두면 checkip.amazonaws.com 으로 자동 감지해 /32 하나를 연다.
# my_ip = "203.0.113.10"
# admin_cidrs = ["203.0.113.10/32", "198.51.100.0/29"]
